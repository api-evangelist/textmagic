{
  "opencollection": "1.0.0",
  "info": {
    "name": "Textmagic REST Bulk Replies API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-TM-Username",
      "value": "{{X-TM-Username}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Replies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all inbound messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.textmagic.com/api/v2/replies",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items per page."
              }
            ]
          },
          "docs": "Get all inbound messages"
        },
        {
          "info": {
            "name": "Get a single inbound message",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.textmagic.com/api/v2/replies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource identifier."
              }
            ]
          },
          "docs": "Get a single inbound message"
        },
        {
          "info": {
            "name": "Delete a single inbound message",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://rest.textmagic.com/api/v2/replies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource identifier."
              }
            ]
          },
          "docs": "Delete a single inbound message"
        }
      ]
    }
  ],
  "bundled": true
}