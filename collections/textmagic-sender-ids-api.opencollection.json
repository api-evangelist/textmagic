{
  "opencollection": "1.0.0",
  "info": {
    "name": "Textmagic REST Bulk Sender IDs API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-TM-Username",
      "value": "{{X-TM-Username}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sender IDs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all your approved Sender IDs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.textmagic.com/api/v2/senderids",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items per page."
              }
            ]
          },
          "docs": "Get all your approved Sender IDs"
        },
        {
          "info": {
            "name": "Apply for a new Sender ID",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://rest.textmagic.com/api/v2/senderids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Apply for a new Sender ID"
        },
        {
          "info": {
            "name": "Get the details of a specific Sender ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.textmagic.com/api/v2/senderids/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource identifier."
              }
            ]
          },
          "docs": "Get the details of a specific Sender ID"
        },
        {
          "info": {
            "name": "Delete a Sender ID",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://rest.textmagic.com/api/v2/senderids/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource identifier."
              }
            ]
          },
          "docs": "Delete a Sender ID"
        }
      ]
    }
  ],
  "bundled": true
}